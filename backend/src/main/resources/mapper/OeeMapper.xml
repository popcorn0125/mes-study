<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.messtudy.backend.mapper.OeeMapper">

    <!-- OEE 합계. 비율은 OeeService가 계산한다. 별칭은 큰따옴표로 감싸 Map 키를 camelCase로 둔다.
         조건(둘 중 하나)
         - from · to: 구간 [from, to)
         - workOrderId: 그 지시의 이벤트만. 시작 ~ 완료(진행 중이면 지금) 앞뒤 1분으로 시각 범위도 좁혀
           occurred_at 인덱스를 타게 한다(시뮬레이터 시계와 서버 시계가 조금 달라도 빠지지 않게 여유를 둔다)
         bucketSec가 있으면 시각 칸(서울 기준 정각 · 5분 단위로 맞춘다)마다 나눈다 -->

    <sql id="bucket">
        <if test="bucketSec != null">
            date_bin(#{bucketSec} * INTERVAL '1 second', ${column}, TIMESTAMPTZ '2000-01-01 00:00:00+09')
        </if>
    </sql>

    <sql id="window">
        <choose>
            <when test="workOrderId != null">
                AND work_order_id = #{workOrderId}
                AND ${column} &gt;= (SELECT started_at - INTERVAL '1 minute' FROM work_order WHERE work_order_id = #{workOrderId})
                AND ${column} &lt;= (SELECT COALESCE(completed_at, now()) + INTERVAL '1 minute' FROM work_order WHERE work_order_id = #{workOrderId})
            </when>
            <otherwise>
                AND ${column} &gt;= #{from}
                AND ${column} &lt; #{to}
            </otherwise>
        </choose>
    </sql>

    <!-- 설비 · (시각 칸)마다 생산한 양품 · 불량 수 -->
    <select id="sumCounts" resultType="map">
        SELECT
            equipment_id AS "equipmentId",
            <if test="bucketSec != null">
                <include refid="bucket"><property name="column" value="occurred_at"/></include> AS "bucketStart",
            </if>
            sum(good_qty) AS "goodCount",
            sum(bad_qty)  AS "badCount"
        FROM production_event
        WHERE true
            <include refid="window"><property name="column" value="occurred_at"/></include>
        GROUP BY 1<if test="bucketSec != null">, 2</if>
    </select>

</mapper>
