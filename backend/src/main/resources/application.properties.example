spring.application.name=backend
server.port=8080

# 개발 DB. 이 파일을 application.properties로 복사한 뒤 password에 로컬 DB 비밀번호를 적는다(application.properties는 커밋하지 않는다).
spring.datasource.url=jdbc:postgresql://localhost:5432/mes
spring.datasource.username=postgres
spring.datasource.password=여기에_비밀번호

# 서버가 뜰 때 schema.sql을 실행한다(CREATE TABLE IF NOT EXISTS라 이미 있으면 그대로 둔다).
spring.sql.init.mode=always

mybatis.mapper-locations=classpath:mapper/*.xml
# 조회 결과 Map에 값이 null인 열(온도 · 진동 등)도 키를 남긴다(기본은 키를 빼 버린다)
mybatis.configuration.call-setters-on-nulls=true

# 센서 로그를 보내는 프론트 개발 서버 주소(CORS 허용)
app.cors.allowed-origins=http://localhost:5173

# 센서 1분 요약 · 원본 아카이브(docs/plans/sensor-rollup.md). 모두 기본값이 있어 적지 않아도 된다.
# 1초 원본은 스풀(CSV)에 이어 쓰고 1시간마다 Parquet으로 바꾼다. 경로는 서버를 띄운 폴더 기준(gitignore: data/)
#mes.sensor.spool-dir=data/spool
#mes.sensor.archive-dir=data/archive/sensor-log
# 분이 끝나고 이만큼(초) 기다린 뒤 요약을 DB에 넣는다
#mes.sensor.flush-grace-sec=5
